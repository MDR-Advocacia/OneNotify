# Local Postgres used by Docker Compose.
POSTGRES_DB=onenotify
POSTGRES_USER=onenotify
POSTGRES_PASSWORD=onenotify
POSTGRES_PORT=5433

# Used by scripts/migrate_sqlite_to_postgres.py when run from Windows.
POSTGRES_DSN=postgresql://onenotify:onenotify@localhost:5433/onenotify
SOURCE_RPA_DB=C:\OneNotify\rpa_refatorado.db
SOURCE_LEGALONE_DB=C:\OneNotify\database.db
MIGRATION_BATCH_SIZE=1000

# Local service ports.
API_PORT=5000
FRONTEND_PORT=3000
RPA_NOVNC_PORT=6080
RPA_VNC_PORT=5900

# OneLog integration used by the RPA container.
# Leave username/password blank to reuse the user saved in the Chrome profile.
ONELOG_LOGIN_MODE=profile
ONELOG_API_URL=https://api-onelog.mdradvocacia.com
ONELOG_LOAD_BUNDLED_EXTENSION=true
ONELOG_FORCE_LEGACY_PROFILE_FLOW=false
ONELOG_USERNAME=
ONELOG_PASSWORD=
ONELOG_LOGIN_TIMEOUT_MS=360000

# RPA supervisor loop. Equivalent to executar_loop.bat:
# 1800s after success, 120s after failure.
RPA_PAUSA_SUCESSO_SEGUNDOS=1800
RPA_PAUSA_FALHA_SEGUNDOS=120

# Flow/API document JSON extraction limit.
ONENOTIFY_PDF_MAX_TEXT_CHARS=200000
ONENOTIFY_FLOW_API_KEY=
ONENOTIFY_PUBLIC_BASE_URL=https://onenotify.mdradvocacia.com
