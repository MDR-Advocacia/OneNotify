FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY painel-onenotify/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY db_adapter.py /app/db_adapter.py
COPY document_payload.py /app/document_payload.py
COPY flow_sync.py /app/flow_sync.py
COPY painel-onenotify /app

EXPOSE 5000

CMD ["gunicorn", "--bind", "0.0.0.0:5000", "server:app"]
